# Copia este archivo a .env y ajusta los valores.
# En desarrollo, si no existe .env, la app usa este archivo como respaldo.
# Nunca uses estos secretos de ejemplo en producción.
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/citaclara
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=8h
# URL pública de la app; se usa para armar los enlaces de "gestionar mi cita"
APP_URL=http://localhost:4000
DEFAULT_TIMEZONE=America/Mexico_City

# Google OAuth 2.0 (login con Google + Google Calendar). Opcional: sin estos valores
# la app funciona y el botón "Continuar con Google" muestra que no está configurado.
# Cómo obtenerlos: README → "Configurar Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
