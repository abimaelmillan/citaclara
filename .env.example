# Copia este archivo a .env y ajusta los valores.
# En desarrollo, si no existe .env, la app usa este archivo como respaldo.
# Nunca uses estos secretos de ejemplo en producción.
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/citaclara
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=8h
# URL pública de la app; se usa para armar los enlaces de "gestionar mi cita"
APP_URL=http://localhost:4000
DEFAULT_TIMEZONE=America/Mexico_City
